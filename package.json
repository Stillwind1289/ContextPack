{
  "name": "contextpack",
  "displayName": "ContextPack",
  "description": "Bundle selected project files into AI-ready context with one command.",
  "version": "0.0.1",
  "publisher": "ventrynlabs",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "context",
    "copy",
    "prompt",
    "files"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:promptpack.copySelectedFiles"
  ],
  "contributes": {
    "commands": [
      {
        "command": "promptpack.copySelectedFiles",
        "title": "PromptPack: Copy Selected Files for AI"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "promptpack.copySelectedFiles",
          "group": "1_modification",
          "when": "explorerViewletFocus"
        }
      ],
      "editor/context": [
        {
          "command": "promptpack.copySelectedFiles",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT"
}
